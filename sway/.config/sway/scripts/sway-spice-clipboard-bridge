#!/usr/bin/env python3
"""
sway-spice-clipboard-bridge - Bidirectional SPICE Host <-> Sway Guest Clipboard Bridge.

Bypasses wlroots Xwayland window-focus gating by managing the X11 CLIPBOARD selection
as a real GTK client while relaying changes to/from Wayland via wl-paste and wl-copy.
Automatically active in QEMU/KVM SPICE guests.
"""

import fcntl
import glob
import os
import signal
import subprocess
import sys
import threading
import time

# Singleton lock: prevent duplicate processes
lock_path = f"/tmp/sway-spice-clipboard-bridge-{os.getuid()}.lock"
try:
    lock_file = open(lock_path, "w")
    fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
except (BlockingIOError, OSError):
    sys.exit(0)

# Check if running in a SPICE virtual machine
is_spice = (
    os.path.exists("/run/spice-vdagentd/spice-vdagent-sock")
    or os.path.exists("/dev/virtio-ports/com.redhat.spice.0")
)
if not is_spice:
    sys.exit(0)

os.environ.setdefault("GDK_BACKEND", "x11")

# Clean environment copy for Wayland subcommands (wl-copy, wl-paste)
WL_ENV = dict(os.environ)
os.environ.pop("WAYLAND_DISPLAY", None)

# Locate WAYLAND_DISPLAY if not set in environment (e.g. under systemd --user)
if "WAYLAND_DISPLAY" not in WL_ENV:
    wl_socks = glob.glob(f"/run/user/{os.getuid()}/wayland-[0-9]*")
    if wl_socks:
        WL_ENV["WAYLAND_DISPLAY"] = os.path.basename(wl_socks[0])

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk

TEXT_MIME = "text/plain;charset=utf-8"
SAFETY_NET_MS = 10000

last_text = None
busy = False
watcher = None


def log(msg):
    print(f"[spice-clipboard-bridge] {msg}", flush=True)


def wl_copy(text):
    try:
        subprocess.run(
            ["wl-copy", "--type", TEXT_MIME, "--", text],
            timeout=5,
            check=False,
            env=WL_ENV,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass


def adopt_from_wayland(text):
    """Wayland clipboard changed -> serve it on X11 so spice-vdagent can read it."""
    global last_text
    if not text or text == last_text:
        return
    last_text = text
    clipboard.set_text(text, -1)


def adopt_once(text):
    adopt_from_wayland(text)
    return GLib.SOURCE_REMOVE


def reconcile():
    """Inspect X11 selection and repair ownership when unreadable."""
    global last_text, busy
    if busy:
        return True
    busy = True
    try:
        xtext = clipboard.wait_for_text()
        if xtext is None:
            if last_text is not None:
                clipboard.set_text(last_text, -1)
        elif xtext != last_text:
            last_text = xtext
            wl_copy(xtext)
    finally:
        busy = False
    return True


def reconcile_once():
    reconcile()
    return GLib.SOURCE_REMOVE


def on_owner_change(_clipboard, _event):
    GLib.idle_add(reconcile_once)


def watch_wayland():
    """Run `wl-paste --watch`, delivering each new clipboard value on stdout."""
    global watcher
    try:
        watcher = subprocess.Popen(
            ["wl-paste", "--watch", "sh", "-c", "base64 -w0; echo"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=WL_ENV,
        )
        import base64

        for line in watcher.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                text = base64.b64decode(line).decode("utf-8")
            except Exception:
                continue
            GLib.idle_add(adopt_once, text)
    except Exception as e:
        log(f"wl-paste watcher error: {e}")


def shutdown(*_a):
    if watcher and watcher.poll() is None:
        watcher.terminate()
    Gtk.main_quit()


# Retry loop to connect to Xwayland (up to 30s)
display = None
for attempt in range(60):
    target_disp = os.environ.get("DISPLAY")
    if not target_disp:
        x_socks = sorted(glob.glob("/tmp/.X11-unix/X[0-9]*"))
        if x_socks:
            target_disp = ":" + os.path.basename(x_socks[-1])[1:]
            os.environ["DISPLAY"] = target_disp

    if target_disp:
        try:
            display = Gdk.Display.open(target_disp)
            if display is not None:
                break
        except Exception:
            pass

    time.sleep(0.5)

if display is None:
    log("Could not open Xwayland display after 30s. Exiting.")
    sys.exit(1)

clipboard = Gtk.Clipboard.get_for_display(display, Gdk.SELECTION_CLIPBOARD)

signal.signal(signal.SIGTERM, shutdown)
signal.signal(signal.SIGINT, shutdown)

clipboard.connect("owner-change", on_owner_change)
threading.Thread(target=watch_wayland, daemon=True).start()
GLib.timeout_add(SAFETY_NET_MS, reconcile)
log(f"Started on DISPLAY={os.environ.get('DISPLAY')}")
Gtk.main()
